-- CartoRig Atomic / Native Fusion world-map vector renderer.
-- NEW implementation based on publicly documented Fusion Fuse APIs.
-- Uses a local, immutable Natural Earth geometry pack. Never downloads data.
-- This file is independent of the UIManager Scene process at render time.

FuRegisterClass("CartoRigAtomicLand", CT_SourceTool, {
    REGS_Name = "CartoRig Atomic — Land & Borders",
    REGS_Category = "CartoRig Atomic",
    REGS_OpIconString = "CRG",
    REGS_OpDescription = "Offline WGS84 vector land, coast and country borders",
    REG_Source_GlobalCtrls = true,
    REG_Source_SizeCtrls = true,
})

local cachedData
local cachedError
local function path_to_data()
    -- Optional test/build override; editors use the installed per-user path.
    local testData=os.getenv("CARTORIG_ATOMIC_DATA_DIR")
    if testData and testData~="" then
        return testData.."/geometry.tsv"
    end
    local app=os.getenv("APPDATA")
    if not app or app=="" then
        return nil,"APPDATA unavailable. Cannot resolve installed offline geography."
    end
    return app..
      "\\Blackmagic Design\\DaVinci Resolve\\Support\\Fusion\\Scripts\\Comp"..
      "\\CartoRigAtomic_Data\\geometry.tsv"
end

local function parse_ring(text)
    local role,points=text:match("^([OH]):(.+)$")
    if not role then return nil,"Invalid Natural Earth ring role" end
    local result={role=role,positions={}}
    for pair in (points..";"):gmatch("(.-);") do
        local lon,lat=pair:match("^([%d%+%-%.]+),([%d%+%-%.]+)$")
        lon,lat=tonumber(lon),tonumber(lat)
        if not lon or not lat or lon~=lon or lat~=lat or
           lon < -180 or lon > 180 or lat < -90 or lat > 90 then
            return nil,"Invalid offline WGS84 polygon vertex"
        end
        result.positions[#result.positions+1]={lon,lat}
    end
    if #result.positions<3 then return nil,"Polygon ring too short" end
    return result
end

local function read_world_geometry()
    local path,reason=path_to_data()
    if not path then return nil,reason end
    local source=io.open(path,"rb")
    if not source then return nil,"Offline Natural Earth polygon file missing" end
    local first=source:read("*l")
    if first~="CARTORIG_ATOMIC_GEOMETRY_V1" then
        source:close()
        return nil,"Unsupported Natural Earth geometry pack"
    end
    local polygons={}
    local countries=0
    local rings=0
    for line in source:lines() do
        local id,count,encoded=line:match("^([^\t]+)\t([^\t]+)\t(.+)$")
        if not id or not count or not encoded then
            source:close()
            return nil,"Malformed offline Natural Earth polygon record"
        end
        if id:match("^ne10m:country:") then
            countries=countries+1
            local expected=tonumber(count)
            if not expected or expected < 1 or expected > 20000 then
                source:close()
                return nil,"Invalid multipart polygon count"
            end
            local found=0
            for value in (encoded.."|"):gmatch("(.-)|") do
                local ring,issue=parse_ring(value)
                if not ring then source:close() return nil,issue end
                polygons[#polygons+1]=ring
                found=found+1
                rings=rings+1
                if rings>40000 then
                    source:close()
                    return nil,"World geometry exceeds safe ring count"
                end
            end
            if found~=expected then
                source:close()
                return nil,"Missing Natural Earth polygon ring"
            end
        end
    end
    source:close()
    if countries<200 or #polygons<200 then
        return nil,"Incomplete offline Natural Earth Admin0 world"
    end
    return polygons
end

local function current_world()
    if cachedData then return cachedData,nil end
    if cachedError then return nil,cachedError end
    local polygon,reason=read_world_geometry()
    if not polygon then
        cachedError=reason
        print("CartoRig Data Error: "..tostring(reason))
        return nil,reason
    end
    cachedData=polygon
    return cachedData,nil
end

local function add_color(component,title,defaults,group)
    local controls={}
    for index,label in ipairs({"Red","Green","Blue","Alpha"}) do
        controls[index]=self:AddInput(title.." "..label,component..label,{
            ICS_Name=index==1 and title or nil,
            LINKID_DataType="Number",
            INPID_InputControl="ColorControl",
            INP_Default=defaults[index],
            INP_MinScale=0,INP_MaxScale=1,
            IC_ControlGroup=group,
            IC_ControlID=index-1,
            ICS_ControlPage="Control",
        })
    end
    return controls
end

function Create()
    InWater=add_color("Ocean","Ocean Fill",{16/255,40/255,60/255,1},1)
    InLand=add_color("Land","Land Fill",{57/255,76/255,89/255,1},2)
    InStroke=add_color("Border","Country Borders",{150/255,170/255,185/255,1},3)
    InWaterOpacity=self:AddInput("Ocean Layer Opacity","OceanOpacity",{
        LINKID_DataType="Number", INPID_InputControl="SliderControl",
        INP_Default=1,INP_MinScale=0,INP_MaxScale=1,
        ICS_ControlPage="Control",
    })
    InLandOpacity=self:AddInput("Land Layer Opacity","LandOpacity",{
        LINKID_DataType="Number", INPID_InputControl="SliderControl",
        INP_Default=1,INP_MinScale=0,INP_MaxScale=1,
        ICS_ControlPage="Control",
    })
    InBorderOpacity=self:AddInput("Country Border Opacity","BorderOpacity",{
        LINKID_DataType="Number", INPID_InputControl="SliderControl",
        INP_Default=1,INP_MinScale=0,INP_MaxScale=1,
        ICS_ControlPage="Control",
    })
    InBorderWidth=self:AddInput("Border Width (px)","BorderWidthPx",{
        LINKID_DataType="Number",INPID_InputControl="SliderControl",
        INP_Default=1,INP_MinScale=0,INP_MaxScale=10,
        ICS_ControlPage="Control",
    })
    InOverlay=self:AddInput("Transparent Overlay","TransparentOverlay",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",
        INP_Integer=true,INP_Default=0,ICS_ControlPage="Control",
    })
    OutMap=self:AddOutput("Map RGBA","Output",{
        LINKID_DataType="Image",LINK_Main=1,
    })
end

local function rgba(controls,req,opacity)
    local values={}
    for i=1,4 do
        values[i]=controls[i]:GetValue(req).Value
    end
    local alpha=math.max(0,math.min(1,values[4]*opacity))
    return Pixel({R=values[1]*alpha,G=values[2]*alpha,
                  B=values[3]*alpha,A=alpha})
end

local function draw_shape(image,shape,pixel)
    local channel=ImageChannel(image,8)
    local style=ChannelStyle()
    style.Color=pixel
    channel:ShapeFill(shape)
    channel:PutToImage("CM_Merge",style)
end

local function world_shape(rings,aspect)
    local path=Shape()
    for _,ring in ipairs(rings) do
        -- Source orientation of exterior and inner rings is preserved, so
        -- the winding fill rule keeps lakes/holes transparent.
        local vertices=ring.positions
        local first=vertices[1]
        path:MoveTo((first[1]+180)/360, ((first[2]+90)/180)*aspect)
        for i=2,#vertices do
            local v=vertices[i]
            path:LineTo((v[1]+180)/360,((v[2]+90)/180)*aspect)
        end
        path:Close()
    end
    return path
end

function Process(req)
    local imageWidth=math.floor(Width/Scale+.5)
    local imageHeight=math.floor(Height/Scale+.5)
    if imageWidth<1 or imageHeight<1 then
        print("CartoRig Render: invalid Fusion frame dimensions")
        return
    end
    local attributes={
        IMG_Document=self.Comp,
        {IMG_Channel="Red"},{IMG_Channel="Green"},
        {IMG_Channel="Blue"},{IMG_Channel="Alpha"},
        IMG_Width=imageWidth,IMG_Height=imageHeight,
        IMG_XScale=XAspect,IMG_YScale=YAspect,
        IMAT_OriginalWidth=Width,IMAT_OriginalHeight=Height,
        IMG_Quality=not req:IsQuick(),
        IMG_MotionBlurQuality=not req:IsNoMotionBlur(),
    }
    local image=Image(attributes)
    local transparent=InOverlay:GetValue(req).Value>.5
    local waterAlpha=transparent and 0 or InWaterOpacity:GetValue(req).Value
    image:Fill(rgba(InWater,req,waterAlpha))
    local geometry,issue=current_world()
    if not geometry then
        -- Opaque magenta is unmistakable; never silently render black
        -- or a fabricated world when the official data bundle is absent.
        image:Fill(Pixel({R=1,G=0,B=.85,A=1}))
        OutMap:Set(req,image)
        return
    end
    if not transparent then
        local aspect=(imageHeight*YAspect)/(imageWidth*XAspect)
        local path=world_shape(geometry,aspect)
        local landAlpha=InLandOpacity:GetValue(req).Value
        if landAlpha>.0001 then
            draw_shape(image,path,rgba(InLand,req,landAlpha))
        end
        local width=InBorderWidth:GetValue(req).Value
        local lineAlpha=InBorderOpacity:GetValue(req).Value
        if width>.0001 and lineAlpha>.0001 then
            local border=path:OutlineOfShape(width/imageWidth,"OLT_Solid")
            draw_shape(image,border,rgba(InStroke,req,lineAlpha))
        end
    end
    OutMap:Set(req,image)
end
