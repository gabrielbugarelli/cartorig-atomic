-- CartoRig Atomic / INSPECTOR LAB (research spike)
-- All geography is schematic; no search, datasets, or map product logic.
-- Do not treat static macro inputs as a dynamic object browser.
{
    Tools = ordered() {
        CRAtomic_InspectorLab = MacroOperator {
            Inputs = ordered() {
                Input1 = InstanceInput { SourceOp = "Base_BG", Source = "TopLeftRed", Name = "Base Map Fill", Page = "Map", ControlGroup = 101, Default = 0.45 },
                Input2 = InstanceInput { SourceOp = "Base_BG", Source = "TopLeftGreen", Name = "Base Map Fill Green", Page = "Map", ControlGroup = 101, Default = 0.55 },
                Input3 = InstanceInput { SourceOp = "Base_BG", Source = "TopLeftBlue", Name = "Base Map Fill Blue", Page = "Map", ControlGroup = 101, Default = 0.55 },
                Input4 = InstanceInput { SourceOp = "Base_BG", Source = "TopLeftAlpha", Name = "Base Map Fill Alpha", Page = "Map", ControlGroup = 101, Default = 1 },
                Input5 = InstanceInput { SourceOp = "Region_A_BG", Source = "TopLeftRed", Name = "Region A Fill", Page = "Objects", ControlGroup = 102, Default = 0.45 },
                Input6 = InstanceInput { SourceOp = "Region_A_BG", Source = "TopLeftGreen", Name = "Region A Fill Green", Page = "Objects", ControlGroup = 102, Default = 0.55 },
                Input7 = InstanceInput { SourceOp = "Region_A_BG", Source = "TopLeftBlue", Name = "Region A Fill Blue", Page = "Objects", ControlGroup = 102, Default = 0.55 },
                Input8 = InstanceInput { SourceOp = "Region_A_BG", Source = "TopLeftAlpha", Name = "Region A Fill Alpha", Page = "Objects", ControlGroup = 102, Default = 1 },
                Input9 = InstanceInput { SourceOp = "Region_B_BG", Source = "TopLeftRed", Name = "Region B Fill", Page = "Objects", ControlGroup = 103, Default = 0.45 },
                Input10 = InstanceInput { SourceOp = "Region_B_BG", Source = "TopLeftGreen", Name = "Region B Fill Green", Page = "Objects", ControlGroup = 103, Default = 0.55 },
                Input11 = InstanceInput { SourceOp = "Region_B_BG", Source = "TopLeftBlue", Name = "Region B Fill Blue", Page = "Objects", ControlGroup = 103, Default = 0.55 },
                Input12 = InstanceInput { SourceOp = "Region_B_BG", Source = "TopLeftAlpha", Name = "Region B Fill Alpha", Page = "Objects", ControlGroup = 103, Default = 1 },
                Input13 = InstanceInput { SourceOp = "Layer_A_Merge", Source = "Blend", Name = "Region A Opacity", Page = "Objects", Default = 0.95, MinScale = 0, MaxScale = 1 },
                Input14 = InstanceInput { SourceOp = "Layer_B_Merge", Source = "Blend", Name = "Region B Opacity", Page = "Objects", Default = 0.95, MinScale = 0, MaxScale = 1 },
                Input15 = InstanceInput { SourceOp = "Scene_Camera", Source = "Size", Name = "Camera Zoom", Page = "Camera", Default = 1, MinScale = 0.25, MaxScale = 3 },
                Input16 = InstanceInput { SourceOp = "Scene_Camera", Source = "Center", Name = "Camera Center", Page = "Camera", DefaultX = 0.5, DefaultY = 0.5 },
                Input17 = InstanceInput { SourceOp = "Probe_Text", Source = "StyledText", Name = "Text Entry (not a search)", Page = "Probe" },
            },
            Outputs = {
                MainOutput1 = InstanceOutput { SourceOp = "Label_Merge", Source = "Output" },
            },
            Tools = ordered() {
                Base_BG = Background {
                    Inputs = {
                        UseFrameFormatSettings = Input { Value = 1 },
                        TopLeftRed = Input { Value = 0.12 },
                        TopLeftGreen = Input { Value = 0.18 },
                        TopLeftBlue = Input { Value = 0.25 },
                        TopLeftAlpha = Input { Value = 1 },
                    },
                },
                Region_A_Mask = RectangleMask {
                    Inputs = {
                        Center = Input { Value = { 0.35, 0.48 } },
                        Width = Input { Value = 0.29 },
                        Height = Input { Value = 0.29 },
                    },
                },
                Region_A_BG = Background {
                    Inputs = {
                        UseFrameFormatSettings = Input { Value = 1 },
                        TopLeftRed = Input { Value = 0.85 },
                        TopLeftGreen = Input { Value = 0.44 },
                        TopLeftBlue = Input { Value = 0.21 },
                        TopLeftAlpha = Input { Value = 1 },
                        EffectMask = Input { SourceOp = "Region_A_Mask", Source = "Mask" },
                    },
                },
                Layer_A_Merge = Merge {
                    Inputs = {
                        Background = Input { SourceOp = "Base_BG", Source = "Output" },
                        Foreground = Input { SourceOp = "Region_A_BG", Source = "Output" },
                        Blend = Input { Value = 0.95 },
                    },
                },
                Region_B_Mask = RectangleMask {
                    Inputs = {
                        Center = Input { Value = { 0.66, 0.50 } },
                        Width = Input { Value = 0.24 },
                        Height = Input { Value = 0.22 },
                    },
                },
                Region_B_BG = Background {
                    Inputs = {
                        UseFrameFormatSettings = Input { Value = 1 },
                        TopLeftRed = Input { Value = 0.55 },
                        TopLeftGreen = Input { Value = 0.76 },
                        TopLeftBlue = Input { Value = 0.43 },
                        TopLeftAlpha = Input { Value = 1 },
                        EffectMask = Input { SourceOp = "Region_B_Mask", Source = "Mask" },
                    },
                },
                Layer_B_Merge = Merge {
                    Inputs = {
                        Background = Input { SourceOp = "Layer_A_Merge", Source = "Output" },
                        Foreground = Input { SourceOp = "Region_B_BG", Source = "Output" },
                        Blend = Input { Value = 0.95 },
                    },
                },
                Scene_Camera = Transform {
                    Inputs = {
                        Input = Input { SourceOp = "Layer_B_Merge", Source = "Output" },
                        Center = Input { Value = { 0.5, 0.5 } },
                        Size = Input { Value = 1 },
                    },
                },
                Probe_Text = TextPlus {
                    Inputs = {
                        StyledText = Input { Value = "STATIC LABEL / NOT GEO SEARCH" },
                        Size = Input { Value = 0.035 },
                        Center = Input { Value = { 0.5, 0.84 } },
                    },
                },
                Label_Merge = Merge {
                    Inputs = {
                        Background = Input { SourceOp = "Scene_Camera", Source = "Output" },
                        Foreground = Input { SourceOp = "Probe_Text", Source = "Output" },
                    },
                },
            },
        },
    },
    ActiveTool = "CRAtomic_InspectorLab",
}
